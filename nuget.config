<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Every package comes from nuget.org, and only from there (central package management, Directory.Packages.props,
    wants each package's source said: NU1507). A machine's own extra feeds are not asked for this repository's packages.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
