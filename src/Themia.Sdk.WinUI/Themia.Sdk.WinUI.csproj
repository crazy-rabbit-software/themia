<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The widget SDK, WinUI part (docs/WIDGET-KIT.md section 4.2): the UI parts every widget is drawn
    with. References Themia.Sdk only, never Core. Files moved here from the app keep their
    Themia.App.* namespaces (Q17); new types use Themia.Sdk.*.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <IsAotCompatible>true</IsAotCompatible>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Themia.Sdk\Themia.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app uses the moved parts' internals exactly as it did when they were its own. -->
    <InternalsVisibleTo Include="Themia" />
  </ItemGroup>
</Project>
