<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\WinUI.props" />
  <!--
    The widget SDK, WinUI part (docs/WIDGET-KIT.md section 4.2): the UI parts every widget is drawn
    with. References Themia.Sdk only, never Core. Files moved here from the app keep their
    Themia.App.* namespaces (Q17); new types use Themia.Sdk.*.
  -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <!--
      No unsafe code is written here. CsWinRT's generator needs it for the code it writes so a managed
      list can cross to WinRT under Native AOT (CsWinRT1030): a drag's storage items, ItemDrag.cs.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- SettingsCard, the rows FluentLayout builds the app-layout editor from ([S-1540], [S-1411]). -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Themia.Sdk\Themia.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app uses the moved parts' internals exactly as it did when they were its own. -->
    <InternalsVisibleTo Include="Themia" />
  </ItemGroup>
</Project>
