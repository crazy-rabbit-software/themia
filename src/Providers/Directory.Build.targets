<Project>
  <!-- [S-6911] Items of every provider module project: as a widget's (src/Widgets/Directory.Build.targets). -->
  <PropertyGroup>
    <_ThemiaParentTargets>$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)..'))</_ThemiaParentTargets>
  </PropertyGroup>
  <Import Project="$(_ThemiaParentTargets)" Condition="'$(_ThemiaParentTargets)' != ''" />

  <ItemGroup>
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <AdditionalFiles Include="Localization\Locales\**\*.json" />
    <!-- [S-9929] Recorded answers, Debug only, under the provider's own folder so two providers' "items.json" never meet. -->
    <Content Include="Fixtures\**" Link="Fixtures\$(ThemiaModuleName)\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>
</Project>
