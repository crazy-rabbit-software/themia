<Project>
  <!--
    What every WinUI project says alike: the app, the widget SDK's UI part, every widget module and the module
    test host. The target, the lowest Windows, the one runtime, WinUI itself and the Windows App SDK; each project
    adds what is its own.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
</Project>
