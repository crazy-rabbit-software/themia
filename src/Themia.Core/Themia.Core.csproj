<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Themia.Sdk\Themia.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- [S-16746] The widget gallery's curated tabs, one layout file a tab, built in (read by CuratedLayouts.Load). -->
    <EmbeddedResource Include="Widgets\GalleryLayouts\*.json" LogicalName="gallery-layouts/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fallback tests build tables with gaps on purpose ([S-1104]). -->
    <InternalsVisibleTo Include="Themia.Core.Tests" />
    <!-- The module test host tests the host's rules over every widget of the build (the first-run seed, the stored preferences). -->
    <InternalsVisibleTo Include="Themia.Modules.Tests" />
  </ItemGroup>
</Project>
