<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Themia.App</RootNamespace>
    <AssemblyName>Themia</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- [S-1850] The exe's own icon (Explorer, Start, uninstall entry); windows set the same file at run time. -->
    <ApplicationIcon>Assets\themia.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <!-- Needed for the function-pointer Win32 callbacks (EnumDisplayMonitors, WndProc). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Must stay true even unpackaged: it is what wires up XAML (.xbf) and resources.pri
         generation AND their copy into the publish folder. With it off, publish silently dropped
         every compiled XAML file and the app died at the first InitializeComponent. -->
    <EnableMsixTooling>true</EnableMsixTooling>

    <!--
      [S-1060] Two shapes, one code base. Every build is unpackaged (F5, dotnet build, publish.ps1:
      the Windows App SDK bootstrapper is initialised automatically) except the Microsoft Store
      package, which scripts/package.ps1 builds with -p:ThemiaPackage=true from Package.appxmanifest.
      The app asks PackageIdentity at run time which one it is; nothing is compiled differently.
    -->
    <WindowsPackageType Condition="'$(ThemiaPackage)' != 'true'">None</WindowsPackageType>
    <WindowsPackageType Condition="'$(ThemiaPackage)' == 'true'">MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!--
      Native AOT. This is the whole point of the port: no JIT, no CoreCLR, no warm-up, and a
      working set that does not carry a GC heap full of framework metadata. Every reflection-based
      API is therefore off limits - notably JSON, which goes through a source-generated context.
    -->
    <PublishAot>true</PublishAot>
    <PublishReadyToRun>false</PublishReadyToRun>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <!-- Stack traces stay on: a widget layer that fails silently is unfixable. -->
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>

    <!-- Surface trim/AOT problems as build errors instead of runtime surprises. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <!--
      SettingsCard and SettingsExpander: the exact controls Windows 11's Settings is drawn with
      ([S-1540]). Taken rather than re-drawn because every row of every settings page is one, and a
      hand-made copy drifts from Windows on hover, press, narrow-width wrapping and the expander's
      motion. Proven Native-AOT clean: publishes under IlcTreatWarningsAsErrors.
    -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
  </ItemGroup>

  <!--
    A Debug Native AOT build (publish.ps1 -Configuration Debug, where the render flags run) has the
    ILCompiler interpret static constructors at compile time, as -O does for Release. Without it the
    runtime's own reference-tracking callback (TrackerObjectManager.WalkExternalTrackerObjects ->
    FindReferenceTargetsCallback) runs its class constructor lazily inside the first garbage
    collection that finds a XAML object: the constructor runner allocates, the allocation waits for
    the collection in progress, and the process hangs for good with every thread waiting (seen as the
    gallery's sticker and the clipboard question's popup never finishing: both allocate enough to
    collect while the render's page is alive). The JIT and Release builds never take that path.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <IlcArg Include="--preinitstatics" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Themia.Core\Themia.Core.csproj" />
    <ProjectReference Include="..\Themia.Sdk.WinUI\Themia.Sdk.WinUI.csproj" />
  </ItemGroup>

  <!--
    [S-6911] Every module is a project one folder under src/Widgets or src/Providers: adding the
    folder is the whole registration. The generator below turns their [assembly: ThemiaWidget/
    ThemiaProvider] declarations into the registry; nothing here lists a module.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Widgets\*\*.csproj" />
    <ProjectReference Include="..\Providers\*\*.csproj" />
  </ItemGroup>

  <!--
    [S-6901] The module registry: every [assembly: ThemiaWidget/ThemiaProvider] declaration (the
    module projects', Core's providers, and the widgets still compiled inside the app,
    Widgets/Modules/*.cs) becomes the generated, static ModuleRegistry in Themia.App.Modules.
    Build-time only; nothing of the generator ships.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Themia.Modules.Generator\Themia.Modules.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    <CompilerVisibleProperty Include="RootNamespace" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- [S-1603] The licences of bundled third-party files ship beside the app, as they require. -->
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    [S-9917] The client secrets a provider insists on, compiled in from the build environment.

    One variable, THEMIA_CLIENT_SECRETS, holds them by provider key: google=...;todoist=... (Google
    requires its Desktop client's secret even with PKCE and treats it as non-confidential for
    installed apps, so it ships in the binary - but it is never in source). Official builds set it
    (the release environment loads it from .env). Each entry is checked here as the app's
    ClientSecretRules reads it (a key in camelCase, a secret of 8 to 256 letters, digits, _ - .), so a
    broken value fails the build instead of shipping. Without it the generated value is empty and
    every member that needs a secret refuses up front. A generated constant rather than an assembly
    attribute, because Native AOT does not promise to keep attribute metadata a runtime lookup needs.
  -->
  <Target Name="ThemiaBuildSecrets" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_ThemiaSecrets>$(THEMIA_CLIENT_SECRETS)</_ThemiaSecrets>
      <_ThemiaBuildSecretsFile>$(IntermediateOutputPath)BuildSecrets.g.cs</_ThemiaBuildSecretsFile>
    </PropertyGroup>
    <Error Condition="'$(_ThemiaSecrets)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(_ThemiaSecrets)', '^\s*[a-z][A-Za-z0-9]{0,63}\s*=\s*[A-Za-z0-9_.-]{8,256}\s*(;\s*[a-z][A-Za-z0-9]{0,63}\s*=\s*[A-Za-z0-9_.-]{8,256}\s*)*;?\s*$'))"
           Text="THEMIA_CLIENT_SECRETS must be key=secret pairs separated by ';' (a key in camelCase, a secret of 8 to 256 letters, digits, _ - .)." />
    <ItemGroup>
      <_ThemiaSecretLine Include="// Generated at build time from THEMIA_CLIENT_SECRETS. Never committed." />
      <_ThemiaSecretLine Include="namespace Themia.App.Services.Accounts%3B" />
      <_ThemiaSecretLine Include="internal static partial class BuildSecrets" />
      <_ThemiaSecretLine Include="{" />
      <_ThemiaSecretLine Include="    private const string Raw = &quot;$([MSBuild]::Escape('$(_ThemiaSecrets.Trim())'))&quot;%3B" />
      <_ThemiaSecretLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_ThemiaBuildSecretsFile)" Lines="@(_ThemiaSecretLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_ThemiaBuildSecretsFile)" />
      <FileWrites Include="$(_ThemiaBuildSecretsFile)" />
    </ItemGroup>
  </Target>

  <!--
    Publish the compiled XAML.

    The XAML compiler emits .xbf (compiled XAML) and resources.pri into the BUILD output but never
    registers them as publish items, so `dotnet publish` produced a folder with no XAML in it at all.
    The app then started fine and threw XamlParseException at the first InitializeComponent - a
    failure that only ever appears in the published build, never during development.

    The publish folder sits inside $(OutDir), so the glob excludes it: without that, every publish
    copied the previous publish's .xbf files into publish\publish\ (one level deeper each time).
  -->
  <Target Name="PublishCompiledXaml"
          AfterTargets="Build"
          BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_CompiledXamlPayload Include="$(OutDir)**\*.xbf" Exclude="$(PublishDir)**" />
      <_CompiledXamlPayload Include="$(OutDir)resources.pri" Condition="Exists('$(OutDir)resources.pri')" />

      <ResolvedFileToPublish Include="@(_CompiledXamlPayload)">
        <RelativePath>$([MSBuild]::MakeRelative($(OutDir), %(FullPath)))</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
    [S-1073] The Store package's TargetDeviceFamily. The MSIX tooling writes its own default item
    (TargetPlatformMinVersion / TargetPlatformVersion: 10.0.17763 / 10.0.19041) over the manifest's
    MinVersion and MaxVersionTested; this one carries the manifest's values instead: Windows 11, tested
    on 24H2. StorePackageTests keeps the two in step.
  -->
  <PropertyGroup Condition="'$(ThemiaPackage)' == 'true'">
    <AppxAddDefaultTargetDeviceFamilyItem>false</AppxAddDefaultTargetDeviceFamilyItem>
  </PropertyGroup>
  <ItemGroup Condition="'$(ThemiaPackage)' == 'true'">
    <TargetDeviceFamily Include="Windows.Desktop">
      <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
      <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    </TargetDeviceFamily>
  </ItemGroup>

</Project>
