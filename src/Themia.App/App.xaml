<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Themia.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The stock Fluent control set: the app looks like the rest of Windows by default. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Widget chrome. Sizes follow the Fluent type ramp rather than inventing a scale. -->
            <x:Double x:Key="WidgetHeaderHeight">28</x:Double>
            <Thickness x:Key="WidgetContentPadding">12</Thickness>
            <x:Double x:Key="ResizeHandleSize">10</x:Double>

            <!--
                The app-layout editor's window ([S-1411]), drawn as a Windows 11 Settings page through
                Shell/FluentLayout.cs. Styles rather than brushes set from code, because only a
                ThemeResource in a style follows the window's own light/dark choice; a brush looked up
                from code is the app's theme, not the window's.
            -->
            <Style x:Key="SettingsSectionHeaderTextBlockStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style>

            <Style x:Key="SettingsNoteTextBlockStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="1,4,0,8" />
            </Style>

            <!-- A card that is not a SettingsCard: the layout canvas. Same fill, stroke and radius. -->
            <Style x:Key="SettingsCardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16,12,16,12" />
                <Setter Property="MinHeight" Value="68" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>

</Application>
