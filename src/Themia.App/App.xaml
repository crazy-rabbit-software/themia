<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Themia.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The stock Fluent control set: the app looks like the rest of Windows by default. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Widget chrome. Sizes follow the Fluent type ramp rather than inventing a scale. -->
            <x:Double x:Key="WidgetHeaderHeight">28</x:Double>
            <Thickness x:Key="WidgetContentPadding">12</Thickness>
            <x:Double x:Key="ResizeHandleSize">10</x:Double>

            <!--
                The settings window, drawn as Windows 11's Settings ([S-1540]). Styles rather than
                brushes set from code, because only a ThemeResource in a style follows the window's
                own light/dark choice; a brush looked up from code is the app's theme, not the
                window's. Used by Shell/FluentLayout.cs and Shell/Config/ConfigWindow*.cs.
            -->
            <x:Double x:Key="SettingsCardSpacing">4</x:Double>
            <x:Double x:Key="SettingsPageMaxWidth">1000</x:Double>

            <Style x:Key="SettingsSectionHeaderTextBlockStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style>

            <Style x:Key="SettingsPageTitleTextBlockStyle" BasedOn="{StaticResource TitleTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <Style x:Key="SettingsDescriptionTextBlockStyle" BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsNoteTextBlockStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="1,4,0,8" />
            </Style>

            <Style x:Key="SettingsCaptionTextBlockStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- A card that is not a SettingsCard: a list item, a sign-in flow. Same fill, stroke and radius. -->
            <Style x:Key="SettingsCardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16,12,16,12" />
                <Setter Property="MinHeight" Value="68" />
            </Style>

            <!-- The row a search result lands on, ringed in the accent for a moment as Windows does. -->
            <Style x:Key="SettingsHighlightBorderStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>

            <!-- A colour swatch's frame: the stroke Windows draws round its accent swatches. -->
            <Style x:Key="SettingsSwatchBorderStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>

            <Style x:Key="SettingsDangerIconStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>

</Application>
