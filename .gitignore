# ---- .NET build output ---------------------------------------------------------------------
bin/
obj/
artifacts/
TestResults/
*.binlog
# Render sets written for looking at (agents cannot read artifacts/).
store/out/

# ---- IDEs ----------------------------------------------------------------------------------
.vs/
.idea/
.vscode/
*.user
*.suo
*.DotSettings.user

# ---- Secrets -------------------------------------------------------------------------------
# Release credentials live here on main. Never committed from any branch.
.env
.env.*

# ---- Local tooling -------------------------------------------------------------------------
.claude/*
# The project's skills are shared; their per-run plans and logs are not.
!.claude/skills/
.claude/skills/*/runs/
*.log

# ---- Store screenshots -------------------------------------------------------------------
# store/capture.ps1 writes here; the scenes and wallpapers next to it are the source.
store/out/
# node store/wallpapers.mjs fetches these from the sources store/wallpapers.json lists.
store/wallpapers/
