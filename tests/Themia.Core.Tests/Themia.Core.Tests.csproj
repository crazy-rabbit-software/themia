<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <!-- Runs the string-table generator in-process to test its merge / duplicate / stray rules ([S-1111]). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- The repository locator the source-scanning tests share with the module test host. -->
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Themia.Sdk\Themia.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Themia.Core\Themia.Core.csproj" />
    <ProjectReference Include="..\..\src\Themia.Localization.Generator\Themia.Localization.Generator.csproj" />
    <!-- Runs the module registry generator in-process to test its id and contract rules ([S-6901]). -->
    <ProjectReference Include="..\..\src\Themia.Modules.Generator\Themia.Modules.Generator.csproj" />
  </ItemGroup>
</Project>
